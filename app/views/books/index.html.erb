<div class="container">
  <% if @track_hash.present? %>
    <div class="row mt-3 justify-content-center">
      <div class="col-12 col-lg-8 shadow-sm p-4 rounded bg-light">
        <div class="row">
          <div class="col-5 text-end">
            <%= image_tag @track_hash[:image_url].gsub('100x100', '210x210'), class: "img-fluid" %>
          </div>
          <div class="col-7 d-flex flex-column">
            <div class="mt-1">
              <div class="fw-semibold"><%= link_to(@track_hash[:title], @track_hash[:applemusic_url], class: "text-dark") %></div>
              <div><%= @track_hash[:artist] %></div>
            </div>
            <div class="mt-auto">
              <div class="mb-2"><%= audio_tag(@track_hash[:preview_url], controls: true, style: "transform: scale(0.9); transform-origin: left;") %></div>
              <div class="text-muted text-end" style="font-size: 0.75rem;">provided courtesy of iTunes</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="row mt-4 mb-2">
      <div class="col-12 text-center">
        <h2 class="fw-bold fs-4 pb-1 border-bottom border-2 border-primary d-inline-block px-4">検索結果</h2>
      </div>
    </div>
    <div class="row mt-2 gy-4 mb-3">
      <%= render @books %>
    </div>
  <% else %>
    <div class="alert alert-warning text-center mt-3">作品が見つかりませんでした</div>
  <% end %>

  <div class="row mb-3">
    <a href="https://developers.rakuten.com/" target="_blank" rel="noopener noreferrer" class="col-12 text-end text-muted text-decoration-none small">
      Supported by Rakuten Developers
    </a>
  </div>
</div>