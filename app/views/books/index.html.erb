<div class="container">
  <div class="row mt-3">
    <div class="col-5 text-end">
      <%= image_tag @track["artworkUrl100"].gsub('100x100', '210x210'), class: "img-fluid" %>
    </div>
    <div class="col-7 d-flex flex-column">
      <div class="mt-1">
        <div class="fw-semibold"><%= @track["trackName"] %></div>
        <div><%= @track["artistName"] %></div>
      </div>
      <div class="mt-auto">
        <div><%= audio_tag(@track["previewUrl"], controls: true) %></div>
        <div><%= link_to image_tag("https://toolbox.marketingtools.apple.com/api/v2/badges/listen-on-apple-music/badge/en-us"), @track["collectionViewUrl"] %></div>
      </div>
    </div>
  </div>
  <div class="fw-bold text-center fs-3 mt-3">検索結果</div>
  <div class="row mt-2 gy-5 mb-3">
    <%= render @similar_books %>
  </div>
</div>