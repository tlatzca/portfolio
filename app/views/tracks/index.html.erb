<div class="container">
  <% if @book_hash.present? %>
    <div class="row mt-3">
      <div class="col-5 col-lg-3 text-end">
        <%= image_tag @book_hash[:image_url].gsub('200x200', '300x300'), class: "img-fluid" %>
      </div>
      <div class="col-7 d-flex flex-column">
        <div class="mt-1">
          <div class="fw-semibold"><%= @book_hash[:title] %></div>
          <div><%= @book_hash[:author] %></div>
        </div>
        <div class="mt-auto">
          <div><%= @book_hash[:caption] %></div>
        </div>
      </div>
    </div>
    <div class="fw-bold text-center fs-3 mt-3">検索結果</div>
    <div class="row mt-2 gy-5 mb-3">
      <%= render @tracks %>
    </div>
  <% else %>
    <div class="alert alert-warning text-center mt-3">作品が見つかりませんでした</div>
  <% end %>
</div>