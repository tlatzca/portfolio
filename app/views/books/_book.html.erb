<div class="col-5 col-lg-3 text-end">
  <%= image_tag book.image_url.gsub('200x200', '300x300'), class: "img-fluid" %>
</div>
<div class="col-6 col-lg-3 d-flex flex-column">
  <div class="mt-1">
    <div class="fw-semibold"><%= book.title %></div>
    <div><%= book.author %></div>
  </div>
  <div class="mt-auto">
    <div><%= book.caption %></div>
  </div>
</div>