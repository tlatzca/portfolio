<div class="col-12 col-lg-6">
  <div class="shadow-sm p-4 rounded bg-light h-100">
    <div class="row">
      <div class="col-5 text-end">
        <%= image_tag(book.image_url.gsub('200x200', '300x300'), class: "img-fluid") %>
      </div>
      <div class="col-7 d-flex flex-column">
        <div class="mt-1">
          <div class="fw-semibold"><%= link_to(book.title, tracks_path(isbn: book.isbn), class: "text-dark") %></div>
          <div><%= book.author %></div>
        </div>
        <div class="mt-auto">
          <%= truncate(book.caption, length: 100) %>
          <div class="mt-3">
            <%= link_to "楽天で見る", book.rakuten_url, target: "_blank", rel: "noopener", class: "btn btn-outline-dark btn-sm rounded-0 w-100" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>