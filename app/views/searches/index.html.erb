<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
      <%= form_with url: tracks_path, method: :get, class: "shadow-sm p-4 rounded bg-light" do |f| %>
        <div class="mb-2 d-flex justify-content-center">
          <div class="form-check form-check-inline">
            <%= f.radio_button :match, "books", class: "form-check-input", checked: true, onclick: "this.form.action='#{tracks_path}'" %>
            <%= f.label :match_books, "書籍からさがす", class: "form-check-label text-dark fw-bold" %>
          </div>
          <div class="form-check form-check-inline">
            <%= f.radio_button :match, "tracks", class: "form-check-input", onclick: "this.form.action='#{books_path}'" %>
            <%= f.label :match_tracks, "音楽からさがす", class: "form-check-label text-dark fw-bold" %>
          </div>
        </div>

        <div class="input-group">
          <%= f.text_field :query, class: "form-control form-control-lg" %>
          <%= f.submit "作品を検索", class: "btn btn-dark" %>
        </div>
      <% end %>
    </div>
  </div>
</div>